# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境（通常不上传）
env/
venv/
ENV/
.venv

# IDE 配置文件
.vscode/
.idea/
*.swp
*.swo
*~

# 模型检查点文件（通常很大，如果太大可以不上传）
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# 临时和备份文件
*.tmp
*.temp
*.bak
*.backup

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 训练输出目录（如果存在）
checkpoints/
outputs/
wandb/
tensorboard/
runs/

# 注意：数据文件（.json, .jsonl）和图像文件（.png, .jpg）默认会上传
# 如果文件太大（>100MB），GitHub 会拒绝，需要使用 Git LFS
